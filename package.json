{
  "name": "focusproof",
  "productName": "FocusProof",
  "version": "0.3.2",
  "description": "Personal learning accountability and analytics — estimates Actual Learning Time from local behavioural signals.",
  "author": "Flinn Mort",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps && node scripts/fetch-models.mjs",
    "app": "node scripts/launch.mjs",
    "shortcut": "node scripts/launch.mjs --shortcut",
    "screenshots": "node scripts/screenshots.mjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-models": "node scripts/fetch-models.mjs",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chokidar": "^4.0.3",
    "diff": "^8.0.4",
    "electron-updater": "^6.8.9",
    "mammoth": "^1.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "lucide-react": "^1.50.0",
    "prettier": "^3.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15"
  }
}
